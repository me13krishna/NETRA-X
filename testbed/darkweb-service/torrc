# Hidden service for the NETRA-X testbed.
#
# SocksPort 0: this Tor instance publishes a service, it does not proxy client
# traffic. Leaving a SOCKS port open would make the container a general-purpose
# Tor client on the docker network, which is not what this is for.
SocksPort 0
Log notice stdout
DataDirectory /var/lib/tor

HiddenServiceDir /var/lib/tor/hidden_service
HiddenServicePort 80 onion-site:80
HiddenServiceVersion 3
