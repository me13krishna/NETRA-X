# NETRA-X Configuration Environment Variables
APP_ENV=development
SECRET_KEY=netra-x-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=netra
POSTGRES_PASSWORD=netra_secret_pass
POSTGRES_DB=netrax_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://netra:netra_secret_pass@localhost:5432/netrax_db
DATABASE_URL_SYNC=postgresql://netra:netra_secret_pass@localhost:5432/netrax_db

# Graph Database (Neo4j 5)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=netra_neo4j_pass

# Event Bus & Cache (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO S3-Compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=netra_minio_admin
MINIO_SECRET_KEY=netra_minio_secret
MINIO_BUCKET=netra-artifacts
MINIO_SECURE=false

# Search Engine (OpenSearch / pgvector hybrid)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
